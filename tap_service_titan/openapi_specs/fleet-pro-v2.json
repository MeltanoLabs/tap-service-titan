{
    "openapi": "3.1.0",
    "info": {
        "title": "Fleet Pro",
        "version": "1.0"
    },
    "servers": [
        {
            "url": "https://api.servicetitan.io/fleetpro/v2",
            "description": "Production"
        },
        {
            "url": "https://api-integration.servicetitan.io/fleetpro/v2",
            "description": "Integration"
        }
    ],
    "paths": {
        "/tenant/{tenant}/events": {
            "post": {
                "tags": [
                    "Events"
                ],
                "summary": "Retrieves paginated Event data specifically for historical records older than 7 days.",
                "description": "This endpoint filters Event messages based on a time window (maximum 24 hours) and a specific list of Vehicle Identification Numbers (VINs).\n            \n**Constraints:**\n* **Data Age:** Only Event data **older than 7 days** is accessible. Data newer than 7 days are not accessible via API.\n* **Time Window:** The range between StartTime and EndTime must not exceed **24 hours (1 day)**.\n* **Vehicle Count:** The number of VINs provided in the filter is limited to a maximum of **50**.\n* **Record Cap:** The total result set (**TotalItems**) for the query is capped at **10,000 records**.",
                "operationId": "Events_GetEvent",
                "parameters": [
                    {
                        "name": "tenant",
                        "in": "path",
                        "description": "Tenant ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "description": "The filtering criteria, including time window (StartTime/EndTime), VINs, and pagination details (Page/PageSize).",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Fleet.V2.Requests.EventRequestFilter"
                            },
                            "example": {
                                "startTime": "string",
                                "endTime": "string",
                                "vins": [
                                    "string"
                                ],
                                "pagination": {
                                    "pageNumber": 0,
                                    "pageSize": 0
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Returns the requested Event data, wrapped in a PaginatedData model. The reported total item count is capped at 10,000 records.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginatedResponse_Of_Fleet.V2.EventResponse"
                                },
                                "example": {
                                    "page": 0,
                                    "pageSize": 0,
                                    "hasMore": true,
                                    "totalCount": 0,
                                    "data": [
                                        {
                                            "id": "string",
                                            "vin": "string",
                                            "vehicleName": "string",
                                            "location": {
                                                "location": {
                                                    "latitude": 0,
                                                    "longitude": 0
                                                },
                                                "timestamp": "string",
                                                "address": "string"
                                            },
                                            "speedInMph": 0,
                                            "eventName": "string",
                                            "eventType": "string",
                                            "driverName": "string",
                                            "geofenceName": "string"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "If the input  is invalid (e.g., VINs is empty, the time window exceeds 24 hours, etc.).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorResponse"
                                },
                                "example": {
                                    "type": "string",
                                    "title": "string",
                                    "status": 0,
                                    "traceId": "string",
                                    "errors": {},
                                    "data": {}
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "apiKeyHeader": [],
                        "oauth": [
                            "tn.flt.events:w"
                        ]
                    }
                ]
            }
        },
