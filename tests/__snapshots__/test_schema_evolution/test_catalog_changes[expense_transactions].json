              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": [
          "object",
          "null"
        ]
      },
      "employeeId": {
        "description": "Employee associated with the expense, if any.",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "expenseStatus": {
        "description": "MOS-computed export-readiness headline: Pending / ReadyForExport / Exported.\nNull when MOS has not yet produced a verdict (internal NotSet sentinel).\nDistinct from SyncStatus.",
        "type": [
          "string",
          "null"
        ]
      },
      "expenseTransactionId": {
        "description": "Shared MOS expense GUID (stable identifier across ServiceTitan and moneyout-service).",
        "format": "guid",
        "type": [
          "string",
          "null"
        ]
      },
      "externalId": {
        "description": "Provider-side external identifier for this expense (from the originating system).",
        "type": [
          "string",
          "null"
        ]
      },
      "externalSource": {
        "description": "Originating system (e.g., \"Ramp\", \"Manual\").",
        "type": [
          "string",
          "null"
        ]
      },
      "id": {
        "description": "Unique identifier for the expense transaction.",
        "format": "int64",
        "type": "integer"
      },
      "isRefund": {
        "description": "True when this transaction is a refund/reversal rather than a charge.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "job": {
        "additionalProperties": false,
        "description": "Job associated with the expense, if applicable.",
        "properties": {
          "id": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": [
