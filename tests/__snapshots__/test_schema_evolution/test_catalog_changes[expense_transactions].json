        "type": [
          "object",
          "null"
        ]
      },
      "lineItems": {
        "description": "Line items on the expense, each with optional per-line GL/BU/Job/Project overrides.",
        "items": {
          "additionalProperties": false,
          "description": "A single line item on an expense transaction, with optional per-line overrides\nfor GL account, business unit, job, and project.",
          "properties": {
            "amount": {
              "description": "Total amount for the line item.",
              "type": [
                "string",
