  "replication_key": "modifiedOn",
  "replication_method": "INCREMENTAL",
  "schema": {
    "additionalProperties": false,
    "description": "Full projection of an expense transaction returned by the public V2 API.\nStatus axes (SyncStatus, ExpenseStatus, NeedsReview,\nProviderRequirementsMet) are exposed as distinct fields.\nBudget codes and ERP accounting dimensions live in AccountingFields;\nno scalar BudgetCodeId is synthesized.",
    "properties": {
      "accountingFields": {
        "description": "ERP accounting dimension fields (budget codes, cost centers, etc.) forwarded from the expense provider.\nAll FieldDestination values are included. Budget codes live here — no scalar field is synthesized.",
        "items": {
          "additionalProperties": false,
          "description": "A single ERP accounting dimension field on an expense transaction.\nEach row represents one dimension (e.g., Department, Cost Center) from the expense provider.",
          "properties": {
            "dataType": {
              "description": "Value data type (Boolean / Date / FreeFormText / SingleChoice). Null when unknown.",
              "type": [
                "string",
                "null"
              ]
            },
            "erpFieldId": {
              "description": "ERP/external key for the field (provider category_info.external_id). This is the primary identifier integrators use to correlate fields.",
              "type": [
                "string",
                "null"
              ]
            },
            "erpFieldName": {
              "description": "Human-readable name of the ERP accounting field (e.g., \"Department\"). Null when not provided by the expense provider.",
              "type": [
                "string",
                "null"
              ]
            },
            "erpOptionCode": {
              "description": "ERP-side option code when DataType is SingleChoice.",
              "type": [
                "string",
                "null"
              ]
            },
            "fieldCategory": {
              "description": "Verbatim provider category token (e.g., \"COST_CENTER\"). Informational only — use FieldDestination for routing.",
              "type": [
                "string",
                "null"
              ]
            },
            "fieldDestination": {
              "description": "Normalized sync-intent signal (Erp / ServiceTitanOnly / Unspecified).",
              "type": [
                "string",
                "null"
              ]
            },
            "freeFormValue": {
              "description": "Free-form text value when DataType is FreeFormText.",
              "type": [
                "string",
                "null"
              ]
            },
            "optionName": {
              "description": "Human-readable option label when DataType is SingleChoice.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "type": [
          "array",
          "null"
        ]
      },
      "batch": {
        "additionalProperties": false,
        "description": "Accounting batch this expense belongs to, if applicable.",
        "properties": {
          "id": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": [
          "object",
          "null"
        ]
      },
      "businessUnit": {
        "additionalProperties": false,
        "description": "Business unit associated with the expense.",
        "properties": {
          "id": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": [
          "object",
          "null"
        ]
      },
      "cardNumberLast4": {
        "description": "Last 4 digits of the credit card number (display convenience).",
        "type": [
          "string",
          "null"
        ]
      },
      "createdOn": {
        "description": "Date and time when the expense was created.",
        "format": "date-time",
        "type": [
          "string",
          "null"
        ]
      },
      "creditCardAccount": {
        "additionalProperties": false,
        "description": "Credit-side GL account (Liability: Credit Card) this expense was charged to.",
        "properties": {
          "detailType": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": [
          "object",
          "null"
        ]
      },
      "customFields": {
        "description": "ST-defined custom-field values (name/value) attached to this expense via the custom-field\nframework. Distinct from AccountingFields (provider-sourced ERP dimensions).",
        "items": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "type": [
          "array",
          "null"
        ]
      },
      "date": {
        "description": "Date the transaction occurred (from card statement).",
        "format": "date-time",
        "type": [
          "string",
          "null"
        ]
      },
      "debitAccount": {
        "additionalProperties": false,
        "description": "Debit-side GL account (the expense account charged for this transaction).",
        "properties": {
          "detailType": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
